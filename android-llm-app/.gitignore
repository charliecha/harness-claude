# Android-specific ignores for the android-llm-app subproject.

# Gradle build outputs
build/
.gradle/
.kotlin/

# Local Gradle config (per-machine SDK path)
local.properties

# IDE
.idea/
*.iml
.cxx/
captures/

# Native build artifacts and submodule build dir
*.so
*.o
*.a
third_party/llama.cpp/build/
third_party/llama.cpp/build-android/

# Test fixtures (large model files must not be committed)
*.gguf
*.bin
app/src/androidTest/assets/tiny.gguf
# Exception: minimal header-only fixture for JNI instrumented tests
!app/src/androidTest/assets/tinyllama-test.gguf

# Kotlin/Detekt reports
detekt-report.*
build-reports/

# Coverage
.kover/
